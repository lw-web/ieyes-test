{
  "name": "ieyes-test",
  "version": "1.0.0",
  "private": true,
  "description": "UmiJS 3.5 + TypeScript + Ant Design 5 + AntV G2 Project",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--openssl-legacy-provider umi dev",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider umi build",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,less,md}\""
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@antv/g2": "^5.4.8",
    "antd": "^5.27.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@umijs/preset-react": "^1.8.32",
    "cross-env": "^10.1.0",
    "eslint": "^7.32.0",
    "less": "^4.2.0",
    "less-loader": "^7.3.0",
    "prettier": "^3.1.0",
    "typescript": "^4.1.2",
    "umi": "^3.5.41"
  }
}

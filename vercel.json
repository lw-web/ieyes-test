{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm start",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/jsonplaceholder/:match*",
      "destination": "/api/proxy/jsonplaceholder/:match*"
    },
    {
      "source": "/api/fakestore/:match*",
      "destination": "/api/proxy/fakestore/:match*"
    },
    {
      "source": "/api/randomuser/:match*",
      "destination": "/api/proxy/randomuser/:match*"
    },
    {
      "source": "/api/catfact/:match*",
      "destination": "/api/proxy/catfact/:match*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "trailingSlash": false,
  "cleanUrls": true
}
